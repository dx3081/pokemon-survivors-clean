# ===== 多地区合并（2026-10-17 起）：84 个平原物种在 SPECIES_IDS / GROWTH_RATES / LEARNSETS 里（老检查对账用，不动）；
# 其它地区已接线的物种在 data/pokemon_biome_species.gd，下面的查询把两边合起来。 =====
const Extras := preload("res://data/pokemon_biome_species.gd")


# 表内条目数（平原 84 + 其它地区已接线的）。
static func count() -> int:
	return SPECIES_IDS.size() + Extras.ids().size()


# 该稳定 source_species_id 本轮是否有资料。
static func has_species(species_id: int) -> bool:
	return GROWTH_RATES.has(species_id) or Extras.growth_rates().has(species_id)


# 全部准确原 ID 稳定升序（平原 84 + 其它地区已接线的，调用方改不到常量）。
static func species_ids() -> Array[int]:
	var ids: Array[int] = []
	for id in SPECIES_IDS:
		ids.append(int(id))
	for id in Extras.ids():
		ids.append(id)
	ids.sort()
	return ids


# 平原那 84 个（老检查对账用）。
static func plains_species_ids() -> Array[int]:
	var ids: Array[int] = []
	for id in SPECIES_IDS:
		ids.append(int(id))
	return ids


# 原大写下划线名（平原在 SPECIES_NAMES，其它地区取各自资料里的 name）；未知返回 ""。
static func species_name(species_id: int) -> String:
	if SPECIES_NAMES.has(species_id):
		return str(SPECIES_NAMES[species_id])
	return str(Extras.row(species_id).get("name", ""))


# 按稳定 source_species_id 查原 growthRate；未知返回 UNKNOWN(-1)。
static func growth_rate(species_id: int) -> int:
	if GROWTH_RATES.has(species_id):
		return int(GROWTH_RATES[species_id])
	return int(Extras.growth_rates().get(species_id, UNKNOWN))


# 某物种某形态的完整原等级学习表 [[level, move_id], ...] 深副本。
# 原 Ur 有该 form_index 用覆盖，否则用该物种 DP 默认；未知物种返回空数组。
# 调用方改返回值不会污染常量表。
static func learnset_rows(species_id: int, form_index: int = 0) -> Array:
	if not LEARNSETS.has(species_id):
		var extra: Dictionary = Extras.learnsets()
		return (extra[species_id] as Array).duplicate(true) if extra.has(species_id) else []
	if FORM_LEARNSETS.has(species_id):
		var forms: Dictionary = FORM_LEARNSETS[species_id]
		if forms.has(form_index):
			return (forms[form_index] as Array).duplicate(true)
	return (LEARNSETS[species_id] as Array).duplicate(true)
