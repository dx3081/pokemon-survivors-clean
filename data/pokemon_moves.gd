# 变化招式原作的 power 就是 -1；城镇显示“—”，不显示 -1，也不冒充 0 威力攻击。
# 打谁（用户 2026-10-21：“技能能把单人攻击和多人攻击也标出来吗”）：和 main/arts.gd 出招判断同一口径——
# target 0 = 自己（含场地类），group 或 target 6 = 身边一圈，其余 = 最近一只。
static func target_text(move: Dictionary) -> String:
	if int(move.get("target", 3)) == 0:
		return "自身"
	if bool(move.get("group", false)) or int(move.get("target", 3)) == 6:
		return "群体"
	return "单体"


static func power_text(move: Dictionary) -> String:
	var power := int(move.get("power", -1))
	return "—" if power < 0 else str(power)


# 命中显示：原作命中值 -1 表示“必中 / 直接成功、不掷 1..100”（变硬这种自身变化招），
# 不显示成 -1%。1..100 的正常命中值照原样显示百分比。
static func accuracy_text(move: Dictionary) -> String:
	var accuracy := int(move.get("accuracy", 0))
	if accuracy < 0:
		return "必中"
	return "%d%%" % accuracy

# 原完整等级学习表（84 物种原 DP 表 = 1310 行，含尚无本作释放实现的原招式），
# 唯一事实在 data/pokemon_starter_species.gd::LEARNSETS；这里只是兼容别名，不再复制第二份 23 行。
# 每行 [原作习得等级, 招式 id]；等级 0 = 只有“进化当次”才允许学的进化招（原 getLevelMoves(t,true)）。
# 原表是 const 常量、查询只读不修改；来源 / 源块 SHA256 / 逐条核对见
# data/POKEMON_STARTER_SPECIES_SOURCE.md 与 data/POKEMON_LEARNSETS_SOURCE.md，
const LEARNSETS := Starter.LEARNSETS


static func is_implemented(move_id: String) -> bool:
	return IMPLEMENTED.has(move_id)


# 封印 = 本作暂时没有释放实现的招（原表里有、技能页能看到，但不入槽、不会放；标“未开放”）。
static func is_sealed(move_id: String) -> bool:
	return not IMPLEMENTED.has(move_id)


# 官方简体中文名表（data/rogue_upstream/moves_zh.json，键 = 原招式常量名大写）；懒加载一次。
static var _zh_names: Dictionary = {}


# 招式显示名：已有条目用本作条目的名字；否则（封印招）用官方简体名；都没有才退回内部 id。
static func display_name(move_id: String) -> String:
	if MOVES.has(move_id):
		return str(MOVES[move_id]["name"])
	if _zh_names.is_empty():
		var f := FileAccess.open("res://data/rogue_upstream/moves_zh.json", FileAccess.READ)
		if f != null:
			var parsed: Variant = JSON.parse_string(f.get_as_text())
			if parsed is Dictionary:
				_zh_names = parsed
	var row: Variant = _zh_names.get(move_id.to_upper())
	if row is Dictionary and str((row as Dictionary).get("name", "")) != "":
		return str((row as Dictionary)["name"])
	return move_id


# 某物种某形态原表的原始行（含未实现招式）。返回副本，调用方改不到 const 表；没有该物种就空数组。
# 默认 form_index 0 = 原 DP 表；原 Ur 有该形态时由 Species.learnset_rows 走覆盖（5 份）。
static func learnset_rows(species_id: int, form_index: int = 0) -> Array:
	return Starter.learnset_rows(species_id, form_index)


# 本作提前学会的招（用户 2026-10-18：“我是觉得可以让绿毛虫多学一个技能”）：物种 ID -> {招式 id: 提前到的等级}。
# 绿毛虫原表 9 级才学虫咬，但 7 级就进化了，几乎用不上；提前到 3 级（开局十几秒就会学到），第二个能打人的招。
const LEARN_LEVEL_OVERRIDES := {10: {"bug_bite": 3}}


# 原作 getLevelMoves(t, n=false) 语义：取“当前形态”原表里习得等级落在 [from_level, to_level] 的行；
# include_evolution_moves = true 时额外保留等级 0 的进化招（对应源的 n=true，进化提交后才查）。
# 不是把所有低等级 / 等级 1 的招补给新形态：区间下界就是调用方传的 t = lastLevel + 1。
# 只返回已有释放实现的招式（implemented_only=false 时原样返回，供对照 / 资料用），
# 按原表顺序去重，且不修改 LEARNSETS。form_index 照原 speciesForm.getLevelMoves() 的形态查询。
static func learnable_between(species_id: int, from_level: int, to_level: int,
		include_evolution_moves := false, implemented_only := true, form_index := 0) -> Array:
	var out: Array = []
	for row: Array in learnset_rows(species_id, form_index):
		var move_level := int(row[0])
		var move_id := str(row[1])
		# 本作提前学会的招（只改“实战里什么时候学”，原表 learnset_rows 原样不动，对照检查照旧）。
		if move_level > 0 and LEARN_LEVEL_OVERRIDES.has(species_id) and LEARN_LEVEL_OVERRIDES[species_id].has(move_id):
			move_level = mini(move_level, int(LEARN_LEVEL_OVERRIDES[species_id][move_id]))
		if move_level == 0:
			if not include_evolution_moves:
				continue
		elif move_level < from_level or move_level > to_level:
			continue
		if implemented_only and not is_implemented(move_id):
			continue
		if out.has(move_id):
			continue
		out.append(move_id)
	return out


# 兼容旧调用入口：某物种在“正好 level 级”能学的已实现招式；等级 0 的进化招只有
# include_evolution_moves=true 才给（等价 learnable_between(level, level, ...)）。
static func learnable_for(species_id: int, level: int, include_evolution_moves := false) -> Array:
	return learnable_between(species_id, level, level, include_evolution_moves)


# id -> 条目（含 id）
static func by_id() -> Dictionary:
	var out := {}
	for id: String in MOVES:
		var row: Dictionary = MOVES[id].duplicate()
		row["id"] = id
		out[id] = row
	return out


# 按 CATERPIE 的顺序返回条目数组，每个条目都带 id
static func list(move_ids: Array = CATERPIE) -> Array:
	var table := by_id()
	var out: Array = []
	for id: String in move_ids:
		if table.has(id):
			out.append(table[id])
	return out
